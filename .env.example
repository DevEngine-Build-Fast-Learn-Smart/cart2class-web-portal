# Public project URL and publishable key are safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key

# Server-only. Never expose this value in browser code, Flutter code, commits, or logs.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Development provisioning only. Keep false outside a short-lived local demo setup.
ALLOW_DEMO_USERS=false
